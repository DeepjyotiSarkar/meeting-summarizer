# Copy this file to .env and fill in what you use.

# ---- ASR ----
# openai = Whisper API (best accuracy, needs OPENAI_API_KEY)
# local  = faster-whisper on your machine (free, needs ffmpeg, slower)
ASR_PROVIDER=openai
LOCAL_WHISPER_MODEL_SIZE=base

# ---- LLM ----
# openai | anthropic
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ---- Optional features (safe to leave on; each degrades gracefully) ----
ENABLE_SEMANTIC_SEARCH=true
ENABLE_CALENDAR_EXPORT=true
ENABLE_DOCX_EXPORT=true

DATABASE_URL=sqlite:///./meetings.db
